
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model ContactPage {
  id        String   @id @default(cuid())
  email     String
  message   String
  category  String
  createdAt DateTime @default(now())
}


